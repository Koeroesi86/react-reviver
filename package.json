{
  "name": "@koeroesi86/react-reviver",
  "version": "1.0.0",
  "main": "dist/package",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "description": "React component reviver",
  "author": {
    "name": "Krisztian Korosi",
    "url": "https://github.com/Koeroesi86"
  },
  "repository": "github:Koeroesi86/react-reviver",
  "homepage": "https://koeroesi86.github.io/react-reviver/",
  "files": [
    "dist",
    "!dist/example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "@types/react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && dts-bundle-generator --config dts.config.js && webpack",
    "dev": "npm run build && webpack --watch --progress",
    "test": "jest",
    "lint": "eslint --cache --cache-location .cache/eslint/ --ext .ts,.tsx src",
    "generate-version": "node ./scripts/version.js",
    "test:compat": "node ./scripts/compat-smoke.js"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "uuid": "^11.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "overrides": {
    "typescript": "^6.0.3"
  }
}
